COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# The key of the module settings (SpeechKit and LLM): scripts/deploy.sh generates it.
WORKER_API_KEY=

# A slot per concurrent request; an agent's prompt alone can take 8000 tokens.
LLM_SLOTS=3
LLM_CTX_PER_SLOT=16000
LLM_REASONING_EFFORT=low

# Threads of one recognition and recognitions at once.
ASR_THREADS=4
ASR_WORKERS=2
TTS_WORKERS=2
